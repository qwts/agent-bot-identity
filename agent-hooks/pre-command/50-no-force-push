#!/bin/sh
# Force-pushing rewrites history other agents and CI are already building on.
# The reason reaches the agent verbatim, so it can correct itself rather than
# retry the same command.
case "$AGENT_HOOK_TOOL_COMMAND" in
  *"git push"*--force*|*"git push"*" -f "*)
    echo "agents may not force-push; open a PR or use --force-with-lease after checking the remote" >&2
    exit 2
    ;;
esac
