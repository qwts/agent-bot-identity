#!/bin/sh
# Shared agent-context helpers, sourced by hooks/pre-commit and hooks/pre-push.
# Never installed on its own: the installed wrappers exec `agent-bot hook
# <name>`, which runs the sibling hook from this directory.
#
# agent_bot_agent_context: true when the process carries agent-only markers —
# CLAUDECODE, CURSOR_AGENT, COPILOT_AGENT, DEVIN_AGENT, WINDSURF_AGENT,
# MUSE_AGENT, CLAUDE_CODE_ENTRYPOINT, AI_AGENT, GH_AGENT_APP, CODEX_* — or runs
# in an agent account (ENG-0339). The account is classified by an exact roster
# match through the runtime (worktree-token.mjs --account-slug, the same
# slugForHarness the JS resolver uses), never by a glob on the short name, so
# shell and JS agree on what an agent account is. AGENT_BOT_ACCOUNT names the
# account explicitly (tests, launchers); it can only ADD the signal, never
# mask the real account. Never editor markers like
# VSCODE_*/CURSOR_TRACE_ID/WINDSURF_IDE_TYPE/MUSE_RELEASE_INFO, so a human in
# an editor terminal is never evaluated at all. This list must stay in step
# with detectAgentHarness in detect-harness.mjs.
#
# Agent context no longer confines where an agent may commit: under ENG-0339
# the account, not the directory, is bot territory, and a harness in the
# owner's account that resolves to the human is the human's delegate. What
# remains is attribution hygiene — a bot-attributed commit must carry a
# resolvable Agent ID — the uninstalled-mode rule (ENG-0128), and no human
# fallback for a session that stated a bot its checkout is not bound to (#749).
agent_bot_agent_context() {
  [ "$CLAUDECODE" = "1" ] && return 0
  [ "$CURSOR_AGENT" = "1" ] && return 0
  [ "$COPILOT_AGENT" = "1" ] && return 0
  [ "$DEVIN_AGENT" = "1" ] && return 0
  [ "$WINDSURF_AGENT" = "1" ] && return 0
  [ "$MUSE_AGENT" = "1" ] && return 0
  [ -n "$AI_AGENT" ] && return 0
  [ -n "$GH_AGENT_APP" ] && return 0
  [ -n "$CLAUDE_CODE_ENTRYPOINT" ] && return 0
  [ -n "$AGENT_BOT_ACCOUNT" ] && return 0
  if env | grep -q '^CODEX_'; then return 0; fi
  [ -n "$(agent_bot_account_slug)" ] && return 0
  return 1
}

# The App slug the current account resolves to by roster, or nothing. Needs
# the runtime; without Node the account cannot be classified and contributes
# no signal (the env markers above still do).
agent_bot_account_slug() {
  _token_tool=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/../worktree-token.mjs
  [ -f "$_token_tool" ] || return 0
  command -v node >/dev/null 2>&1 || return 0
  node "$_token_tool" --account-slug 2>/dev/null || true
}

# The App this session stated it is (GH_AGENT_APP, a pin, an agent account),
# printed only when the checkout is not bound to it: the committer is still
# the human because worktree setup failed or never ran (#749). Nothing for
# the delegate, which states no identity (ENG-0339, ENG-0375). One decision,
# resolve-agent.mjs unboundBotSlug, shared with the installed runner's
# pre-command check. Exits non-zero when the identity cannot be checked.
agent_bot_unbound_bot() {
  _resolver=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/../resolve-agent.mjs
  [ -f "$_resolver" ] || return 0
  command -v node >/dev/null 2>&1 || return 0
  node --input-type=module -e 'import(process.argv[1]).then(({ unboundBotSlug }) => { const slug = unboundBotSlug(); if (slug) process.stdout.write(slug); }).catch((e) => { console.error("agent-bot: cannot verify the stated bot identity: " + e.message); process.exit(1); })' "$_resolver"
}

# Refuse a commit or push from a stated bot that is not bound here (#749).
# Only with the installed runner: uninstalled mode keeps its own rule
# (ENG-0128), which already refuses human-attributed publishing.
agent_bot_refuse_unbound_bot() {
  _slug=$(agent_bot_unbound_bot) || exit 1
  [ -n "$_slug" ] || return 0
  echo "agent-bot guard: this session stated bot identity $_slug, but this checkout is not bound to it." >&2
  echo "Worktree setup failed or never ran here, so this $1 would be attributed to the human." >&2
  echo "Run: agent-bot setup-worktree in a linked worktree (a primary checkout is refused), check agent-bot doctor, then retry." >&2
  exit 1
}

agent_bot_github_url() {
  case "$1" in
    *github.com*|*github.*) return 0 ;;
  esac
  return 1
}

# True when a remote URL reaches GitHub. A local-path remote counts when the
# repository it names has a GitHub remote itself (one hop). Retained for the
# uninstalled-mode push rule.
agent_bot_url_reaches_github() {
  _url=$1
  agent_bot_github_url "$_url" && return 0
  case "$_url" in file://*) _url=${_url#file://} ;; esac
  [ -d "$_url" ] || return 1
  git -C "$_url" config --get-regexp '^remote\..*\.(push)?url$' 2>/dev/null | {
    while read -r _ _hop; do
      agent_bot_github_url "$_hop" && exit 0
    done
    exit 1
  }
}

# True when any remote of the current repository reaches GitHub.
agent_bot_repo_reaches_github() {
  git config --get-regexp '^remote\..*\.(push)?url$' 2>/dev/null | {
    while read -r _ _url; do
      agent_bot_url_reaches_github "$_url" && exit 0
    done
    exit 1
  }
}

# The unmanaged-author allowlist, comma-separated, from the same resolver
# doctor uses (config.mjs unmanagedAuthors, #675): AGENT_BOT_UNMANAGED_AUTHORS
# when set (even empty), else the agent-bot config, which an organization
# profile projects into. A config the resolver rejects yields nothing, so the
# hook refuses. Without Node or the runtime the compiled `ai9d` stands, as it
# did before the config existed.
agent_bot_unmanaged_authors() {
  if [ "${AGENT_BOT_UNMANAGED_AUTHORS+set}" = set ]; then
    printf '%s' "$AGENT_BOT_UNMANAGED_AUTHORS"
    return 0
  fi
  _config_module=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/../config.mjs
  if [ ! -f "$_config_module" ] || ! command -v node >/dev/null 2>&1; then
    printf '%s' ai9d
    return 0
  fi
  node --input-type=module -e 'import(process.argv[1]).then(({ unmanagedAuthorsWithLegacyDefault }) => process.stdout.write(unmanagedAuthorsWithLegacyDefault().authors.join(","))).catch((e) => { console.error("agent-bot: unmanaged authors unavailable: " + e.message); })' "$_config_module"
}

# True when $1 (a GitHub login, git name, or email) names an unmanaged author
# the operator allowlisted (ENG-0128): such a person may publish as themselves
# from an agent session even in uninstalled mode.
agent_bot_unmanaged_author() {
  _value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
  [ -n "$_value" ] || return 1
  _local=${_value%%@*}
  _authors=$(agent_bot_unmanaged_authors)
  _saved_ifs=$IFS
  IFS=','
  for _part in $_authors; do
    _part=$(printf '%s' "$_part" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    if [ -n "$_part" ] && { [ "$_part" = "$_value" ] || [ "$_part" = "$_local" ]; }; then
      IFS=$_saved_ifs
      return 0
    fi
  done
  IFS=$_saved_ifs
  return 1
}
