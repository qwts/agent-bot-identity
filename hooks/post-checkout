#!/bin/sh
# Configure only the soul of the session doing the checkout. A checkout pin
# alone is never session evidence. No session soul means a silent no-op.
# The runtime checks the soul's work area before any config/credential writes.
# Hook failures never block git checkout; chained user hooks still run.

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SETUP="$HOOK_DIR/../setup-worktree.mjs"
if [ -f "$SETUP" ] && command -v node >/dev/null 2>&1; then
  node "$SETUP" --from-hook || true
fi

# Preserve the hooks path that setup displaced. With none configured,
# chain-hook falls back to the repository's common hooks directory.
"$HOOK_DIR/chain-hook" post-checkout "$@"
