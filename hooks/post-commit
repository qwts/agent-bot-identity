#!/bin/sh
# Record the new commit against its transcript-bound identity (ENG-0081).
# A post-commit failure cannot undo a commit, so report loudly and preserve the
# commit; the trailer remains a durable lookup key for later repair.

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IDENTITY_TOOL="$HOOK_DIR/../agent-identity.mjs"
GITHUB_IDENTITY_ON=0
if command -v node >/dev/null 2>&1; then
  GATE=0
  node --input-type=module -e 'import(process.argv[1]).then(({isGateEnabled}) => process.exit(isGateEnabled("github-identity") ? 0 : 3)).catch((e) => { console.error("agent-bot: cannot read the github-identity gate: " + e.message); process.exit(1); })' "$HOOK_DIR/../config.mjs" || GATE=$?
  case "$GATE" in
    0) GITHUB_IDENTITY_ON=1 ;;
    3) ;;
    *) echo "warning: github-identity gate unreadable; commit $(git rev-parse HEAD 2>/dev/null) was not recorded" >&2 ;;
  esac
fi
if [ "$GITHUB_IDENTITY_ON" = 1 ] && [ -f "$IDENTITY_TOOL" ]; then
  ID=$(node "$IDENTITY_TOOL" current 2>/dev/null || true)
  if [ -n "$ID" ]; then
    SHA=$(git rev-parse HEAD 2>/dev/null || true)
    if [ -n "$SHA" ]; then
      if node "$IDENTITY_TOOL" show "$ID" >/dev/null 2>&1; then
        node "$IDENTITY_TOOL" record "$ID" --artifact "commit:$SHA" >/dev/null 2>&1 || {
          echo "warning: could not record commit $SHA for Agent-Identity $ID" >&2
        }
      fi
    fi
  fi
fi

"$HOOK_DIR/chain-hook" post-commit "$@"
