#!/bin/sh
# pre-commit guard: agents may only commit inside bot territory. Installed
# machine-wide via core.hooksPath, it blocks a commit when ALL three hold:
#   - the process carries agent-only environment markers (CLAUDECODE,
#     AI_AGENT, CODEX_*) — never editor markers, so a human in an editor
#     terminal is never evaluated at all;
#   - the commit would be attributed to the human (identity did not resolve
#     to a *[bot]* — i.e. no bot worktree config applies here);
#   - any remote points at GitHub (a remoteless scratch repo cannot
#     impersonate anyone, and agents legitimately use those for tests).
# Bot-attributed commits must also resolve an Agent ID. The guard fails closed
# for agent processes but does not evaluate ordinary human shells.

AGENT=""
[ "$CLAUDECODE" = "1" ] && AGENT=1
[ -n "$AI_AGENT" ] && AGENT=1
if [ -z "$AGENT" ]; then env | grep -q '^CODEX_' && AGENT=1; fi

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SETUP="$HOOK_DIR/../setup-worktree.mjs"

if [ -n "$AGENT" ]; then
  NAME=$(git config user.name 2>/dev/null || true)
  case "$NAME" in
    *"[bot]"*)
      # Bot attribution alone identifies only the GitHub App. A transcript-bound
      # execution identity is minted by setup-worktree.
      IDENTITY_TOOL="$HOOK_DIR/../agent-identity.mjs"
      ID=""
      if [ -f "$IDENTITY_TOOL" ] && command -v node >/dev/null 2>&1; then
        ID=$(node "$IDENTITY_TOOL" current 2>/dev/null || true)
      fi
      if [ -z "$ID" ] || ! node "$IDENTITY_TOOL" show "$ID" >/dev/null 2>&1; then
        echo "agent-bot guard: bot identity has no resolvable Agent-Identity." >&2
        echo "Run: node $SETUP, then retry." >&2
        exit 1
      fi
      ;;
    *)
      REMOTES=$(git remote -v 2>/dev/null || true)
      case "$REMOTES" in
        *github.com*|*github.*)
          # Inside bot territory but resolving to the human: the worktree
          # config never landed (sandboxed harnesses cannot always write the
          # shared git dir at setup). Name the actual remedy.
          # The .<tool>/worktrees segment is the signal at any root.
          case "$PWD" in
            */.*/worktrees/*)
              echo "agent-bot guard: this IS a bot worktree, but its identity config never landed." >&2
              echo "Run: node $SETUP (from an unsandboxed shell), then retry." >&2
              ;;
            *)
              echo "agent-bot guard: agents may only commit changes within .<tool>/worktrees/<repo>." >&2
              echo "This commit would be attributed to the human ('${NAME:-unset}'). Create or use your tool's worktree." >&2
              ;;
          esac
          exit 1
          ;;
      esac
      ;;
  esac
fi

"$HOOK_DIR/chain-hook" pre-commit "$@"
