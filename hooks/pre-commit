#!/bin/sh
# pre-commit guard: attribution hygiene for agent processes. Installed
# machine-wide via core.hooksPath. When the process is agent context (see
# hooks/agent-context for the marker list and the agent-account rule) and the
# commit is bot-attributed, the bot must carry a resolvable Agent ID — bot
# attribution alone identifies only the GitHub App; the transcript-bound
# execution identity is minted by setup-worktree.
#
# A human-attributed commit from an agent process is not refused (ENG-0339
# supersedes ENG-0045's worktree enforcement): in the owner's account a
# harness that resolves to the human is the human's delegate, and no guard
# confines where it commits. Ordinary human shells are never evaluated.

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SETUP="$HOOK_DIR/../setup-worktree.mjs"
# shellcheck source=hooks/agent-context
. "$HOOK_DIR/agent-context"

if agent_bot_agent_context; then
  NAME=$(git config user.name 2>/dev/null || true)
  case "$NAME" in
    *"[bot]"*)
      IDENTITY_TOOL="$HOOK_DIR/../agent-identity.mjs"
      ID=""
      if [ -f "$IDENTITY_TOOL" ] && command -v node >/dev/null 2>&1; then
        ID=$(node "$IDENTITY_TOOL" current 2>/dev/null || true)
      fi
      if [ -z "$ID" ] || ! node "$IDENTITY_TOOL" show "$ID" >/dev/null 2>&1; then
        echo "agent-bot guard: bot identity has no resolvable Agent-Identity." >&2
        echo "Run: node $SETUP, then retry." >&2
        exit 1
      fi
      ;;
    *)
      : # human persona — delegate work is the human's own (ENG-0339)
      ;;
  esac
fi

AGENT_HOOK="${AGENT_BOT_HOOK_BIN:-$HOME/.local/share/agent-bot/agent-hook}"
if [ -x "$AGENT_HOOK" ]; then
  "$AGENT_HOOK" --dialect git --event pre-commit || exit $?
fi

"$HOOK_DIR/chain-hook" pre-commit "$@"
