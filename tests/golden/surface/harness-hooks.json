{
  "canonicalEvents": [
    "spawn",
    "session-start",
    "session-end",
    "prompt-submit",
    "pre-tool-use",
    "pre-command",
    "pre-file-write",
    "post-tool-use",
    "agent-stop",
    "pre-commit",
    "pre-push"
  ],
  "managedMarker": "agent-bot agent-hook",
  "harnesses": {
    "claude": {
      "file": "<home>/.claude/settings.json",
      "config": {
        "hooks": {
          "SessionStart": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude bind-soul || exit 0 # agent-bot agent-hook (session-start)",
                  "timeout": 60
                }
              ]
            }
          ],
          "SessionEnd": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude session-end || exit 0 # agent-bot agent-hook (session-end)",
                  "timeout": 60
                }
              ]
            }
          ],
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude prompt-submit || exit 2 # agent-bot agent-hook (prompt-submit)",
                  "timeout": 60
                }
              ]
            }
          ],
          "PreToolUse": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude guard-tools || exit 2 # agent-bot agent-hook (pre-tool-use)",
                  "timeout": 60
                }
              ]
            },
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude guard-identity || exit 2 # agent-bot agent-hook (pre-command)",
                  "timeout": 60
                }
              ]
            },
            {
              "matcher": "Write|Edit|MultiEdit",
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude guard-writes || exit 2 # agent-bot agent-hook (pre-file-write)",
                  "timeout": 60
                }
              ]
            }
          ],
          "PostToolUse": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude post-tool-use || exit 0 # agent-bot agent-hook (post-tool-use)",
                  "timeout": 60
                }
              ]
            }
          ],
          "Stop": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "\"$HOME/.claude/agent-bot/hook\" claude agent-stop || exit 2 # agent-bot agent-hook (agent-stop)",
                  "timeout": 60
                }
              ]
            }
          ]
        }
      },
      "adapterDir": "<home>/.claude/agent-bot",
      "dispatcher": "#!/bin/sh\n# agent-bot hook dispatcher — generated by agent-bot sync-hooks; do not edit.\n# The harness config names each hook point by purpose; map it back to the\n# canonical event, run the installed runner when present, and otherwise the\n# co-located uninstalled policy (ENG-0128).\nE=\"$2\"\ncase \"$2\" in\n  bind-soul) E=session-start ;;\n  guard-identity) E=pre-command ;;\n  guard-writes) E=pre-file-write ;;\n  guard-tools) E=pre-tool-use ;;\nesac\nR=\"${AGENT_BOT_HOOK_BIN:-$HOME/.local/share/agent-bot/agent-hook}\"\n[ -x \"$R\" ] && exec \"$R\" --dialect \"$1\" --event \"$E\"\nD=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\nexec node \"$D/uninstalled-policy.mjs\" \"$1\" \"$E\"\n",
      "policySha256": "0b3394632da073e2abced8be4e999dbc371d703716a8dc19cbec08fc7ef37621"
    },
